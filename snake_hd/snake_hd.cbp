<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="snake_hd" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/snake_hd" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
					<Add option="-std=c11" />
					<Add option="-finput-charset=UTF-8" />
				</Compiler>
				<Linker>
					<Add option="-lwinmm" />
				</Linker>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/snake_hd" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
					<Add option="-std=c11" />
					<Add option="-finput-charset=UTF-8" />
				</Compiler>
				<Linker>
					<Add option="-s" />
					<Add option="-lwinmm" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
			<Add option="-Wextra" />
		</Compiler>
		<Unit filename="game.c" />
		<Unit filename="game.h" />
		<Unit filename="main.c" />
		<Unit filename="render.c" />
		<Unit filename="render.h" />
		<Extensions>
			<lib_finder disable_auto="1" />
		</Extensions>
	</Project>
</CodeBlocks_project_file>
