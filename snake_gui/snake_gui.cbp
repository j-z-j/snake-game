<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="snake_gui" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Release">
				<Option output="snake_gui.exe" prefix_auto="0" extension_auto="1" />
				<Option object_output="obj/" />
				<Option type="0" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
					<Add option="-finput-charset=UTF-8" />
				</Compiler>
				<Linker>
					<Add option="-mwindows" />
					<Add option="-static" />
					<Add option="-static-libgcc" />
					<Add option="-static-libstdc++" />
					<Add option="-lgdiplus" />
					<Add option="-lwinmm" />
					<Add option="-lole32" />
					<Add option="-luuid" />
					<Add option="-lshell32" />
					<Add option="-lgdi32" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
			<Add option="-Wextra" />
		</Compiler>
		<Unit filename="game.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="game.h" />
		<Unit filename="snake_gui.cpp">
			<Option compilerVar="CPP" />
		</Unit>
		<Extensions>
			<lib_finder disable_auto="1" />
		</Extensions>
	</Project>
</CodeBlocks_project_file>
